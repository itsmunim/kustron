{
  "name": "kustron",
  "version": "2.1.3",
  "description": "A CLI tool that gives anyone a fully working local Kubernetes setup in minutes",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:unit": "vitest run test/unit --reporter=verbose",
    "test:e2e": "vitest run test/e2e --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only",
    "release": "npm run build && changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsmunim/kustron.git"
  },
  "keywords": [
    "kubernetes",
    "k8s",
    "k3d",
    "local",
    "deploy",
    "cli"
  ],
  "author": "Munim Dibosh",
  "license": "MIT",
  "bin": {
    "kustron": "dist/bin/kustron.js"
  },
  "files": [
    "dist"
  ],
  "bugs": {
    "url": "https://github.com/dibosh/kustron/issues"
  },
  "homepage": "https://github.com/dibosh/kustron#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "chalk": "^5.4.1",
    "chokidar": "^5.0.0",
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "js-yaml": "^4.1.0",
    "listr2": "^8.2.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^5.0.4",
    "prettier": "^3.9.6",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^5.0.4"
  }
}
