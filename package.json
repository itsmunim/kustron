{
  "name": "kustron",
  "version": "2.0.0",
  "description": "A CLI tool that gives anyone a fully working local Kubernetes setup in minutes",
  "type": "module",
  "main": "dist/bin/kustron.js",
  "bin": {
    "kustron": "dist/bin/kustron.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "postinstall": "node dist/scripts/postinstall.js || true",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/dibosh/kustron.git"
  },
  "keywords": [
    "kubernetes",
    "k8s",
    "k3d",
    "local",
    "deploy",
    "cli"
  ],
  "author": "Munim Dibosh",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dibosh/kustron/issues"
  },
  "homepage": "https://github.com/dibosh/kustron#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "js-yaml": "^4.1.0",
    "listr2": "^8.2.5"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  }
}
